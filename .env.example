# 폐쇄망 PaddleOCR 모델 경로 (scripts/download_models.py 로 사전 반입)
PII_OCR_DET_DIR=/opt/ocr_models/det
PII_OCR_REC_DIR=/opt/ocr_models/rec
PII_OCR_CLS_DIR=/opt/ocr_models/cls

# OCR 을 돌릴 GPU 번호 (nvidia-smi 인덱스, 기본 0).
# vLLM 이 0 번을 점유하고 있으면 1 번 등으로 옮겨 경합을 피한다.
# CUDA_VISIBLE_DEVICES 를 함께 쓰면 그 목록 안에서의 상대 번호로 해석된다.
PII_OCR_GPU_ID=0
